PLUGIN: eva,scope,eva.mthread

MACRO: LOG_MT_DOT_FILES_FILENAME @PTEST_NAME@_cfg.@PTEST_NUMBER@.dot
MACRO: LOG_MT_DOT_FILES_OPTS -mt-extract html -mt-concat-dot-files-to @LOG_MT_DOT_FILES_FILENAME@

OPT: -add-symbolic-path=$(realpath @PTEST_SHARE_DIR@/mthread):FRAMAC_SHARE -mthread -cpp-extra-args="-I@PTEST_SHARE_DIR@/mthread" -eva-slevel 15 @PTEST_SHARE_DIR@/mthread/mthread_pthread.c @PTEST_SHARE_DIR@/mthread/mthread_queue.c -mt-verbose 3 -mt-shared-values 2 -mt-shared-accesses-synchronization -eva-msg-key interferences,-summary,-initial-state -eva-no-show-progress -eva-warn-key experimental=inactive -eva-verbose 0 -eva-domains mthread
