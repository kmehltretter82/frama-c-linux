void iota(value_type* a, size_type n, value_type val)
{
  /*@

    loop invariant 0 <= i <= n;
    loop assigns i, a[0..n-1];

    loop invariant \forall integer k; 0 <= k < i
                    ==> a[k] == val + k;
    loop variant n-i;
  */
  for (size_type i = 0; i < n; i++)
    a[i] = val + i;
}
