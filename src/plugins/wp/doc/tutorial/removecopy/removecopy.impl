size_type remove_copy(const value_type* a, size_type n, 
		     value_type* b, value_type v) 
{
  size_type j = 0;
  /*@
    loop assigns b[0..j-1], i, j;
    loop invariant 0 <= j <= i <= n;
    loop invariant RemoveCopy(a, i, b, j, v);
    loop variant n-i;
  */
  for (size_type i = 0; i < n; i++) {
    if (a[i] != v)
      b[j++] = a[i];
  }
  return j;
}
