size_type count(const value_type* a, size_type n, value_type val)
{
  size_type cnt = 0 ;
  /*@ 
    loop invariant 0 <= i <= n; 
    loop invariant 0 <= cnt <= i;
    loop invariant cnt == Count(a, val, 0, i);
    loop assigns i,cnt;
    loop variant n-i; 
  */ 
  for (size_type i = 0; i < n; i++) 
    if (a[i] == val) 
      cnt++;
  return cnt; 
}
