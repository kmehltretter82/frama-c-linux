void reverse_copy(const value_type* a, size_type n, value_type* b) {
  /*@
    loop invariant 0 <= i <= n;
    loop invariant \forall integer k; 0 <= k < i ==> 
                     b[k] == a[n-1-k];

    loop assigns b[0..i-1], i ;
    loop variant n-i;
  */
  for (size_type i = 0; i < n; i++)
    b[i] = a[n-1-i];
}
