size_type max_element(const value_type* a, size_type n) 
{
  if (n == 0) return 0;

  size_type max = 0; 
  /*@
    loop invariant 0 <= i <= n; 
    loop invariant 0 <= max < n; 
    loop invariant IsMaximum(a, i, max); 
    loop invariant IsFirstMaximum(a, max);
    loop assigns i,max;
    loop variant n-i;
   */
  for (size_type i = 0; i < n; i++) 
    if (a[max] < a[i])
      max = i; 

  return max;
}
