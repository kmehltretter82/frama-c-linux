Lemma left_shift_repeat1:
Prove: let a_0 = (concat L_A L_B L_S) in
       (L_C=(concat (repeat a_0 L_N) L_A))=
       (L_C=(concat (repeat a_0 L_N) L_A))

------------------------------------------------------------

