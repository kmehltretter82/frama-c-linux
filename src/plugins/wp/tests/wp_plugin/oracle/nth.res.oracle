Lemma left_unfold_repeat1:
Prove: let a_0 = (concat L_S L_A L_B) in
       (L_C=(concat L_A L_B (repeat a_0 2) L_A L_S))=
       (L_C=(concat L_A L_B (repeat a_0 2) L_A L_S))

