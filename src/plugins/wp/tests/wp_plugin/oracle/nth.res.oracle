Lemma nth_repeat_undefined_1:
Prove: let x_0 = (L_f 0) in
       (nth
         (repeat (concat (elt x_0) (elt (L_f 1)) (elt (L_f 2)) (elt (L_f 3)))
           3) 12)=x_0

