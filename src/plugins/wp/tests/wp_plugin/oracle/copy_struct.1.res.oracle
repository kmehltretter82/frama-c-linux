Goal Post-condition 'post_eq_struct_fields' in 'zeroify_S_fs':
Let a_1 = memcpy(M0022_sint8_0, M0022_sint8_0, a, b, 12).
Let a_2 = shiftfield_F1_S_fca(a).
Let a_3 = a_1[shift_sint8(a_2, 4)].
Let a_4 = memcpy(M000b_sint16_0, M000b_sint16_0, a, b, 12)
            [shiftfield_F1_S_fs(b)].
Let a_5 = memcpy(M0019_sint32_0, M0019_sint32_0, a, b, 12).
Let a_6 = a_5[shiftfield_F1_S_fi(a)].
Let a_7 = a_5[shiftfield_F1_S_fi(b)].
Let m = Array_R0022_sint8(a_2, 6, a_1).
Let m_1 = Array_R0022_sint8(shiftfield_F1_S_fca(b), 6, a_1).
Let x = to_sint16(lxor(a_4, a_4)).
Assume {
  Type: is_sint8(a_3) /\ is_sint16(a_4) /\ is_sint32(a_6) /\
      is_sint32(a_7) /\ IsArray_sint8(m) /\ IsArray_sint8(m_1) /\
      is_sint32(a_6 + a_3 + x).
  (* Heap *)
  Type: (region(a.base) <= 0) /\ (region(b.base) <= 0).
  (* Pre-condition *)
  Have: P_pointed(a, b).
}
Prove: (a_7 = a_6) /\ (x = 0) /\ EqArray_int(6, m, m_1).

