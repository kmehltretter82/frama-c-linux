Let a_5 = a_4[shiftfield_F1_S_fs(b)].
Let a_6 = memcpy(M0029_sint16_0, M0029_sint16_0, a, b, 20).
Let a_7 = shiftfield_F1_S_st(a).
Let a_8 = a_6[shiftfield_F2_T_sts(a_7)].
Let a_9 = shiftfield_F1_S_st(b).
Let a_10 = memcpy(M0019_sint32_0, M0019_sint32_0, a, b, 20).
Let a_11 = a_10[shiftfield_F1_S_fi(a)].
Let a_12 = a_10[shiftfield_F1_S_fi(b)].
Let a_13 = memcpy(M0030_sint32_0, M0030_sint32_0, a, b, 20).
Let a_14 = a_13[shiftfield_F2_T_sti(a_7)].
Let m = Array_R0022_sint8(shiftfield_F1_S_fca(b), 6, a_1).
Let a_15 = Load_R0027_S2_T(a_9, a_6, a_13).
Let x = to_sint16(lxor(a_5, a_5)).
Let a_16 = a_4[shiftfield_F1_S_fs(a) <- x].
Let a_17 = Load_R0003_S1_S(a, a_10, a_1, a_6, a_16, a_13).
Assume {
  Type: is_sint8(a_3) /\ is_sint16(a_5) /\ is_sint16(a_8) /\
      is_sint16(a_6[shiftfield_F2_T_sts(a_9)]) /\ is_sint32(a_11) /\
      is_sint32(a_12) /\ is_sint32(a_14) /\
      is_sint32(a_13[shiftfield_F2_T_sti(a_9)]) /\
      IsArray_sint8(Array_R0022_sint8(a_2, 6, a_1)) /\ IsArray_sint8(m) /\
      IsS2_T(Load_R0027_S2_T(a_7, a_6, a_13)) /\ IsS2_T(a_15) /\
      is_sint32(a_11 + a_3 + a_8 + a_14 + x) /\ IsS1_S(a_17) /\
      IsS1_S(Load_R0003_S1_S(b, a_10, a_1, a_6, a_16, a_13)).
  (* Heap *)
  Type: (region(a.base) <= 0) /\ (region(b.base) <= 0).
  (* Pre-condition *)
  Have: P_pointed(a, b).
}
Prove: EqS1_S(a_17,
         { F1_S_fi = a_12 ; F1_S_fs = 0 ; F1_S_fca = m ; F1_S_st = a_15 }).

