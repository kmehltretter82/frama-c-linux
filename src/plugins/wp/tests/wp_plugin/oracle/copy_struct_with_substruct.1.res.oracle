Cluster Matrix {
  
  Predicate EqArray_int (n_0 : int) (T_0 : int[]) (T_1 : int[])
    = forall i_0:int. (0<=i_0) -> (i_0<n_0) -> (T_1[i_0]=T_0[i_0])
  
  Predicate IsArray_sint8 (T_0 : int[]) = forall i_0:int. (is_sint8 T_0[i_0])
  
}

Cluster MemBytes.PointersProperties {
  
  Predicate framed (m_0 : int[][])
    = forall a_0:addr.
      ((region (base a_0))<=0)
      -> ((region (base (addr_of_int (read_uint64 m_0 a_0))))<=0)
  
  Axiom pointers_int_range:
