Goal Post-condition 'post_eq_struct_with_update' in 'zeroify_S_fs':
Let a_1 = memcpy(M0022_sint8_0, M0022_sint8_0, a, b, 20).
Let a_2 = shiftfield_F1_S_fca(a).
Let a_3 = a_1[shift_sint8(a_2, 4)].
