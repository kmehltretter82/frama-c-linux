  'indirect_not_in_constants' 'indirect_in_constants' 'direct_in'
Prove: member(1, L_Set3) /\ member(2, L_Set3) /\ member(3, L_Set3) /\
    (forall i : Z. (member(i, L_Set3) -> ((i = 1) \/ (i = 2) \/ (i = 3)))).

