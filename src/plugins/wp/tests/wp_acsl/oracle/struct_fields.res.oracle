  type S1_X =
    | S1_X1 (F1_X_a:int) (F1_X_b:int) (F1_X_c:int)
  
  (* use frama_c_wp.cint.Cint *)
  
  predicate IsS1_X (s:S1_X) =
    (is_sint8 (F1_X_a s) /\ is_sint16 (F1_X_b s)) /\ is_sint32 (F1_X_c s)
end
