     separated p 3 q 1 ->
     Load_Init_S1_X p (set init q v) = Load_Init_S1_X p init
  
  axiom Q_Load_Init_S1_X_memcpy_Init0 :
    forall init:addr -> bool, init1:addr -> bool, n:int, p:addr, p1:addr, q:
     addr [Load_Init_S1_X p (memcpy init init1 p1 q n)].
