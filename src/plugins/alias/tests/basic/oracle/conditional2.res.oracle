[kernel] Parsing conditional2.c (with preprocessing)
[alias] May-aliases at the end of function main:
  {d, &e} are aliased
  {a, b, &c} are aliased
  {c, &d} are aliased
Before statement b = & c; :
 
Before statement c = & d; :
 {b, &c} are aliased

Before statement d = & e; :
 {b, &c} are aliased
{c, &d} are aliased

Before statement if (a) a = b; else a = & c; :
 {b, &c} are aliased
{c, &d} are aliased
{d, &e} are aliased

Before statement a = b; :
 {b, &c} are aliased
{c, &d} are aliased
{d, &e} are aliased

Before statement a = & c; :
 {b, &c} are aliased
{c, &d} are aliased
{d, &e} are aliased

Before statement __retres = 0; :
 {d, &e} are aliased
{a, b, &c} are aliased
{c, &d} are aliased

Before statement return __retres; :
 {d, &e} are aliased
{a, b, &c} are aliased
{c, &d} are aliased

