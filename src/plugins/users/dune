(rule
 (alias frama-c-configure)
 (deps (universe))
 (action (progn
          (echo "Users:" %{lib-available:frama-c-users.core} "\n")
          (echo "  - Callgraph:" %{lib-available:frama-c-callgraph.core} "\n")
  )
  )
)

(rule
 (alias install)
 (enabled_if
  (and
   (= %{env:FRAMAC_DEVELOPER=no} "yes")
   (not %{lib-available:frama-c-users.core})))
 (action (echo "WARNING: Users disabled. Run 'dune build @frama-c-configure' for more details\n"))
)


(library
  (name Users)
  (optional)
  (public_name frama-c-users.core)
  (flags -open Frama_c_kernel :standard)
  (libraries frama-c.kernel frama-c-callgraph.core)
  (instrumentation (backend landmarks))
  (instrumentation (backend bisect_ppx))
)

(plugin (optional) (name users) (libraries frama-c-users.core) (site (frama-c plugins)))
