(rule
 (alias frama-c-configure)
 (deps (universe))
 (action (progn
          (echo "Obfuscator:" %{lib-available:frama-c-obfuscator.core} "\n")
  )
  )
)

( library
  (name obfuscator)
  (public_name frama-c-obfuscator.core)
  (flags -open Frama_c_kernel :standard -w -9)
  (libraries frama-c.kernel)
)

(plugin (optional) (name obfuscator) (libraries frama-c-obfuscator.core) (site (frama-c plugins)))
