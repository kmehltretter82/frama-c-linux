float square_root_aux(float x, float n)
{
  float __retres;
  /*@ ghost square_root_aux_pre_func(x,n); */
  float y = (x + n / x) / 2.0f;
  if ((double)(x - y) > 0.001) {
    __retres = y;
    goto return_label;
  }
  else {
    float tmp;
    tmp = square_root_aux(y,n);
    __retres = tmp;
    goto return_label;
  }
  return_label:
  {
    /*@ ghost square_root_aux_post_func(__retres); */
    return __retres;
  }
}

