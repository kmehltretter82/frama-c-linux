%init:		a;
%accept:	i;
%deterministic;

$x : int;

a : { CALL(main) } -> b;

b :
  { CALL(f) && $x := f().x } -> c
| { CALL(g) } -> d
;

c : { RETURN(f) } -> e;

d : { RETURN(g) } -> g;

e :
  { CALL(h) && $x > 0 } -> f
| { RETURN(main) } -> i
;

f : { RETURN(h) } -> g;

g : { CALL(i) } -> h;

h : { RETURN(i) && $x := 1 } -> e;

i : -> i;
