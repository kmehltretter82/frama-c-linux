int main(void)
{
  int __retres;
  int x;
  int y;
  char *s;
  x = 0;
  y = 1;
  /*@ assert x < y; */ ;
  e_acsl_assert(x < y,(char *)"Assertion",(char *)"(x < y)",9);
  /*@ assert y > x; */ ;
  e_acsl_assert(y > x,(char *)"Assertion",(char *)"(y > x)",10);
  /*@ assert x ≤ 0; */ ;
