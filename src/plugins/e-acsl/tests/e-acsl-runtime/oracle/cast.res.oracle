int main(void)
{
  int __retres;
  long x;
  int y;
  x = (long)0;
  y = 0;
  /*@ assert (int)x ≡ y; */ ;
  e_acsl_assert((int)x == y,(char *)"Assertion",(char *)"((int)x == y)",11);
  /*@ assert x ≡ (long)y; */ ;
  e_acsl_assert(x == (long)y,(char *)"Assertion",(char *)"(x == (long)y)",12);
  /*@ assert y ≡ (int)0; */ ;
