                (char *)"(y != (int)0xfffffffffffffff)",18);
  /*@ assert (unsigned int)y ≢ (unsigned int)0xfffffffffffffff; */ ;
  e_acsl_assert(! ((unsigned int)y != (unsigned int)0xfffffffffffffff),
                (char *)"Assertion",
