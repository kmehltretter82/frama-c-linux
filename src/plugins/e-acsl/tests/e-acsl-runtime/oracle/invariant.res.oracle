extern int printf(char const * , ...);
/*@ requires predicate ≢ 0;  */
void e_acsl_assert(int predicate, char *kind, char *pred_txt, int line)
{
  if (! predicate) {
    printf("%s failed at line %d.\nThe failing predicate is:\n%s.\n",kind,
           line,pred_txt);
    exit(1);
  }
  return;
}

int main(void)
{
  int __retres;
  int x;
  x = 0;
  {
    int i;
    i = 0;
    while (1) {
      if (! (i < 10)) { break; }
      /*@ invariant 0 ≤ i ∧ i < 10; */ ;
      { int __e_acsl_and;
        if (0 <= i) { __e_acsl_and = i < 10; }
        else { __e_acsl_and = 0; }
        e_acsl_assert(__e_acsl_and,(char *)"Invariant",
                      (char *)"(0 <= i && i < 10)",9);
      }
      
      x += i;
      /*@ invariant i ≤ x; */ ;
      e_acsl_assert(i <= x,(char *)"Invariant",(char *)"(i <= x)",11);
      i ++;
    }
  }
  
  __retres = 0;
  return (__retres);
}


