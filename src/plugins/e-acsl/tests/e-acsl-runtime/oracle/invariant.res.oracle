extern void exit(int status);
/*@ assigns \nothing;  */
extern int printf(char const * , ...);
void e_acsl_assert(int predicate, char *kind, char *pred_txt, int line)
{
  if (predicate) {
    printf("%s failed at line %d.\nThe failing predicate is:\n%s.\n",kind,
           line,pred_txt);
    exit(1);
  }
  return;
}

int main(void)
{
  int __retres;
  int x;
  x = 0;
  {
    int i;
    i = 0;
    while (1) {
      if (! (i < 10)) { break; }
      /*@ invariant 0 ≤ i ∧ i < 10; */ ;
      { int e_acsl_1;
        if (0 <= i) { e_acsl_1 = i < 10; }
        else { e_acsl_1 = 0; }
        e_acsl_assert(! e_acsl_1,(char *)"Invariant",
                      (char *)"(0 <= i && i < 10)",9);
      }
      
      x += i;
      /*@ invariant i ≤ x; */ ;
      e_acsl_assert(! (i <= x),(char *)"Invariant",(char *)"(i <= x)",11);
      i ++;
    }
  }
  
  __retres = 0;
  return (__retres);
}


