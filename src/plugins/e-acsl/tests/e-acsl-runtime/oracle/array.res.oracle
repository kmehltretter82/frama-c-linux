void e_acsl_assert(int predicate, char *kind, char *pred_txt, int line)
{
  if (! predicate) {
    printf("%s failed at line %d.\nThe failing predicate is:\n%s.\n",kind,
           line,pred_txt);
    exit(1);
  }
  return;
}

