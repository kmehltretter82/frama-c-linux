*
req_3 = door_1_open -> cabin_1_stoped
req_5 = (Top cabin_1_direction) -> cabin_1_stoped
req_6_1 = (cabin_1_stoped & (! cabin_1_called)) -> cabin_1_waiting
req_6_2 = (Bot cabin_1_waiting) -> cabin_1_called
req_8_1 = ((G[-40,0] door_1_open) & cabin_1_opening_button_pressed)-> (!cabin_1_accepting_ext_call)
req_13_1 = (Top cabin_1_target_floor) -> (cabin_1_accepting_new_target | cabin_1_stoped)
pos_cb1_stoped =(cabin_1_stoped & position_cabin_1)
past_target = V[-3] cabin_1_target_floor
array[2] past_target pos_cb1_stoped
req_14 = (Top door_1_open) -> (E[0,6] door_1_ttly_open)
req1000 = time_is_zero -> (cabin_1_waiting & cabin_1_stoped)
*
hazard_3 = ! req_3
hazrard_5 = ! req_5
hazard_6_1 = ! req_6_1
hazard_6_2 = ! req_6_2
hazard_8_1 = ! req_8_1
hazard_13_1 = ! req_13_1
hazard_13_2 = !(((Top cabin_1_stoped)  & (V[-3] cabin_1_target_defined)) -> ('==' array))
hazard_14 = ! req_14
hazard_1000 = ! req1000
target_cab_1 = (cabin_1_target_floor & false)