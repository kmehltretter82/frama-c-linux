{
    "version" : "MSVC - X86-64bits mode",
    "compiler" : "msvc",
    "cpp_arch_flags" : ["-m64"],
    "sizeof_short" : 2,
    "sizeof_int"   : 4,
    "sizeof_long"      : 4,
    "sizeof_longlong" :  8,
    "sizeof_ptr"      :  8,
    "sizeof_float"    : 4,
    "sizeof_double"   : 8,
    "sizeof_longdouble"  : 8,
    "sizeof_void"     : 0,
    "sizeof_fun"      : -1,
    "size_t" : "unsigned long long",
    "wchar_t" : "unsigned short",
    "ptrdiff_t": "long long",
    "alignof_short": 2,
    "alignof_int" : 4,
    "alignof_long" : 4,
    "alignof_longlong": 8,
    "alignof_ptr" : 8,
    "alignof_float" : 4,
    "alignof_double" : 8,
    "alignof_longdouble": 8,
    "alignof_str" : 1,
    "alignof_fun" : -1,
    "alignof_aligned": 1,
    "char_is_unsigned" : false,
    "little_endian": true,
    "has__builtin_va_list": false
}
