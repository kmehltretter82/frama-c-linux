[kernel] Parsing asm_qualifiers.i (no preprocessing)
/* Generated by Frama-C */
int asm_inline(int value)
{
  /*@ assigns value;
      assigns value \from value; */
  __asm__ volatile ("" : "+r" (value));
  return value;
}

int asm_volatile_goto(void)
{
  int __retres;
  /*@ assigns \nothing; */
  __asm__ goto volatile ("" :  :  :  :target);
  __retres = 0;
  goto return_label;
  target: __retres = 1;
  return_label: return __retres;
}


