{
  "source": {
    "include": [
      "src/dome/doc/README.md",
      "build"
    ]
  },
  "opts": {
    "recurse": true,
    "tutorials": "src/dome/doc/tutorials",
    "template": "src/dome/doc/template"
  },
  "plugins": [ "plugins/markdown" ],
  "templates": {
    "default": {
      "useLongnameInNav": true,
      "outputSourceFiles": false,
      "includeDate": false
    }
  }
}
