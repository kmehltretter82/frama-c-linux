DOME_DEV_PACKAGES= \
	@babel/core@^7 \
	@babel/preset-env \
	@babel/preset-react \
	@babel/plugin-proposal-object-rest-spread \
	electron@^7 \
	electron-builder \
	electron-webpack \
	electron-devtools-installer \
	webpack \
	babel-loader \
	css-loader \
	react-hot-loader \
	@hot-loader/react-dom \
	@types/react

DOME_APP_PACKAGES= \
	react@^16.8 \
	react-dom \
	source-map-support \
	lodash \
	react-virtualized \
	react-draggable \
	codemirror

