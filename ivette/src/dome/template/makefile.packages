# --------------------------------------------------------------------------
# ---  Packages Definitions for Dome environment                         ---
# --------------------------------------------------------------------------

DOME_DEV_PACKAGES= \
	@babel/core \
	@babel/preset-env \
	@babel/preset-react \
	@babel/plugin-proposal-object-rest-spread \
	electron@^25 \
	electron-builder@^24 \
	electron-vite@^1 \
	electron-devtools-installer \
	babel-loader \
	css-loader@^5 \
	@types/react@^18 \
	@types/react-dom@^18 \
	@types/react-virtualized@^9.21.8

DOME_APP_PACKAGES= \
	react@^18 \
	react-dom@^18 \
	source-map-support \
	lodash \
	react-virtualized \
	react-draggable \
	react-fast-compare \
	diff

